#!/bin/bash
# Fake ping. STUB_PING_SEQ="down down up" is consumed one call at a time; last value repeats.
f="${T:-/tmp}/ping.idx"; i=$(cat "$f" 2>/dev/null || echo 0); echo $((i+1)) > "$f"
set -- ${STUB_PING_SEQ:-up}; n=$#; [ "$i" -ge "$n" ] && i=$((n-1))
shift "$i"; echo "ping $1" >> "${STUB_LOG:-/dev/null}"
[ "$1" = up ]
